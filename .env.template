# API Keys and Credentials
FITBIT_CLIENT_ID=your_fitbit_client_id_here
FITBIT_CLIENT_SECRET=your_fitbit_client_secret_here
FITBIT_REDIRECT_URI="http://127.0.0.1:5000/fitbit/callback"

SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI="http://127.0.0.1:5000/spotify/callback"

# Flask Configuration
SECRET_KEY=your-secret-key-here

# Firebase / Firestore
# Path to your Firebase service account JSON key file
FIREBASE_CREDENTIALS_PATH=path/to/serviceAccountKey.json

# OpenRouter API (Primary AI Model - using OpenAI-compatible interface)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat

# Application Settings
FLASK_ENV=development
FLASK_DEBUG=True
